{
	"name": "beadle",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-07",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "beadle",
			"database_name": "beadleNext",
			"database_id": "e6d04892-59d1-493c-a135-ebbb37d270ec"
		}
	],
	"triggers": {
		"crons": ["0 * * * *"]
	},
	"assets": {
		"directory": "./public",
		"binding": "public",
		"run_worker_first": true
	}
}
