{
    "projects": {
        "test": {
            "projectType": "application",
            "root": "front",
            "sourceRoot": "front/src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "outputPath": "public",
                        "browser": "front/src/main.ts",
                        "tsConfig": "front/tsconfig.app.json",
                        "inlineStyleLanguage": "less",
                        "assets": [
                            {
                                "glob": "**/*",
                                "input": "front/assets"
                            }
                        ],
                        "styles": ["front/src/styles.less"]
                    }
                }
            }
        }
    }
}
